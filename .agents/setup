#!/usr/bin/env bash
set -euo pipefail

if ! command -v composer >/dev/null || ! php -r 'exit(PHP_VERSION_ID >= 80300 && extension_loaded("pdo_sqlite") && extension_loaded("gd") && extension_loaded("mbstring") && extension_loaded("dom") && extension_loaded("curl") ? 0 : 1);'; then
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y composer php-cli php-curl php-gd php-mbstring php-sqlite3 php-xml php-zip
fi

composer kirby
npm ci --no-audit --no-fund

# Reuse the orb's installed Chromium for the Playwright Panel check.
chrome=$(find "$HOME/.agent-browser/browsers" -type f -name chrome | sort -V | tail -1)
test -x "$chrome"
ln -sfn "$chrome" node_modules/.bin/utm-chrome
