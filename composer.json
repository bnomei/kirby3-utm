{
    "name": "bnomei/kirby3-utm",
    "type": "kirby-plugin",
    "version": "6.0.0",
    "license": "MIT",
    "description": "Kirby UTM Tracking",
    "authors": [
        {
            "name": "Bruno Meilick",
            "email": "b@bnomei.com"
        }
    ],
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "seo",
        "utm",
        "campaign",
        "tracking",
        "sqlite"
    ],
    "autoload": {
        "psr-4": {
            "Bnomei\\": "classes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-pdo_sqlite": "*",
        "ext-sqlite3": "*",
        "getkirby/composer-installer": "^1.2",
        "jaybizzle/crawler-detect": "^1.2",
        "matomo/device-detector": "^6.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "getkirby/cms": "^6.0",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^v3.5.1",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "stan": "tests/vendor/bin/phpstan",
        "fix": "tests/vendor/bin/pint",
        "test": "tests/vendor/bin/pest --profile",
        "dist": [
            "composer fix",
            "composer install --no-dev --optimize-autoloader",
            "git rm -rf --cached .; git add .;"
        ],
        "kirby": "COMPOSER_VENDOR_DIR=tests/vendor composer install"
    },
    "extra": {
        "kirby": {
            "compatible": "^6.0"
        },
        "kirby-cms-path": "tests/kirby"
    }
}
